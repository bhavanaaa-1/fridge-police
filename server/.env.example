PORT=5000

# Neon pooled connection string for the Express/Prisma runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Neon direct (unpooled) connection string for Prisma migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Authentication (replace with a long random secret)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d