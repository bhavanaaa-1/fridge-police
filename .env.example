# Neon PostgreSQL pooled connection string for runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Neon PostgreSQL direct connection string for Prisma CLI / migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
NEON_BRANCH=production

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Optional: Neon test branch connection strings for integration test suite
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST.REGION.aws.neon.tech/DB?sslmode=require"
TEST_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@TEST_HOST.REGION.aws.neon.tech/DB?sslmode=require"
